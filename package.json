{
  "name": "clausefully",
  "version": "0.2.0",
  "private": false,
  "description": "Local-first open-source writing assistant with intent locks, review-first edits, and BYOK.",
  "license": "MIT",
  "homepage": "https://clausefully.nex3sss.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satwik-P28/clausefully.git"
  },
  "bugs": {
    "url": "https://github.com/Satwik-P28/clausefully/issues"
  },
  "keywords": [
    "writing-assistant",
    "grammarly-alternative",
    "local-first",
    "privacy",
    "byok",
    "open-source",
    "typescript",
    "react"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib tests vitest.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "esbuild": "^0.28.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.39.0",
    "react": "^19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.12.3",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.10.1",
    "shadcn": "4.19.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "^8.10.1",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260831.1": true
  }
}
