    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "esbuild": "^0.28.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
